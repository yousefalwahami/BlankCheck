{
  "name": "@blankcheck/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "trace": "tsx src/scripts/trace.ts",
    "chain:smoke": "tsx --env-file-if-exists=.env src/scripts/chain-smoke.ts"
  },
  "dependencies": {
    "@blankcheck/shared": "workspace:^",
    "@thru/passkey": "0.3.16",
    "@thru/programs": "0.3.16",
    "@thru/sdk": "0.3.16",
    "@typesafe-ai/sdk": "^0.6.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "socket.io-client": "^4.8.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
