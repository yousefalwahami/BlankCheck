PORT=4000
# Comma-separated, or * (a party game with no auth; the host token protects host actions)
CORS_ORIGINS=*

# mock = same referee rules in memory (no chain). thru = the C program on Thru alphanet.
REFEREE_MODE=mock
# Wait for PULL_TRIGGER / REVEAL confirmations before firing / showing the verdict (capped).
WAIT_FOR_CHAIN=true
CHAIN_WAIT_CAP_MS=4000

THRU_RPC_URL=https://rpc.alphanet.thru.org
EXPLORER_URL=https://scan.thru.org
# House key: 32-byte Ed25519 seed, hex or base64 (fee payer + table host). Never commit it.
THRU_HOST_SECRET=
# From `programs/referee/deploy.sh` (thru program create …)
REFEREE_PROGRAM_ADDRESS=
# Optional: defaults to the address exported by @thru/programs/passkey-manager
PASSKEY_MANAGER_PROGRAM_ADDRESS=
# Optional per-transaction resource requests (SDK defaults: 300000000 / 10000 / 10000).
# Raise state/memory units if CREATE_TABLE (a ~75 KB account) is rejected for resources.
THRU_COMPUTE_UNITS=
THRU_STATE_UNITS=
THRU_MEMORY_UNITS=

# Jev by TypeSafe (bots + Pit Boss). Without a key, bots use code-only heuristics.
TYPESAFE_API_KEY=
JEV_MODEL=

# Optional: repeatable demo (Uncle Gary is dealt HOT LOAD in round 1)
DEMO_SEED=
